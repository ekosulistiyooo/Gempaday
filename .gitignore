:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #e5eefb;
  background: #071426;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
}

body {
  background:
    radial-gradient(circle at top, rgba(68, 132, 255, 0.2), transparent 35%),
    #071426;
}

button {
  font: inherit;
}

.page-shell {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
  padding: 32px 0 48px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
  padding: 18px 20px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 18px;
  background: rgba(15, 23, 42, 0.8);
  backdrop-filter: blur(10px);
}

.eyebrow,
.section-label {
  margin: 0 0 8px;
  color: #8ab4ff;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.7rem;
  font-weight: 700;
}

.topbar h1,
.hero h2 {
  margin: 0;
}

.live-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(52, 211, 153, 0.12);
  border: 1px solid rgba(52, 211, 153, 0.4);
  color: #7ef0c2;
  font-size: 0.8rem;
  font-weight: 700;
}

.live-badge::before {
  content: '';
  width: 8px;
  height: 8px;
  background: #34d399;
  border-radius: 50%;
  box-shadow: 0 0 10px #34d399;
}

.content {
  display: grid;
  gap: 24px;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.refresh-button {
  border: none;
  border-radius: 12px;
  background: linear-gradient(135deg, #60a5fa, #2563eb);
  color: white;
  padding: 10px 18px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 10px 26px rgba(37, 99, 235, 0.35);
}

.status-box {
  border-radius: 18px;
  padding: 20px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(15, 23, 42, 0.8);
}

.status-box p {
  margin: 0;
  font-weight: 600;
}

.status-box.loading {
  border-color: rgba(96, 165, 250, 0.36);
  color: #bfdbfe;
}

.status-box.error {
  border-color: rgba(248, 113, 113, 0.42);
  color: #fecaca;
}

.status-box.empty {
  border-color: rgba(148, 163, 184, 0.24);
  color: #dbeafe;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.stat-card {
  display: grid;
  gap: 8px;
  padding: 22px 18px;
  border-radius: 18px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(15, 23, 42, 0.8);
}

.stat-card.accent {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.3), rgba(15, 23, 42, 0.9));
  border-color: rgba(96, 165, 250, 0.34);
}

.stat-card span,
.stat-card small {
  color: #bfd7ff;
}

.stat-card strong {
  font-size: clamp(1.8rem, 2vw, 2.4rem);
  line-height: 1;
}

.table-card {
  padding: 18px;
  border-radius: 18px;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.2);
}

.table-header {
  margin-bottom: 12px;
}

.table-header h3 {
  margin: 0;
  font-size: 1.1rem;
}

.table-wrapper {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 760px;
}

th,
td {
  padding: 14px 12px;
  text-align: left;
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
}

th {
  color: #bfdbfe;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.date-block {
  display: grid;
  gap: 2px;
}

.date-block span {
  color: #b3c5e9;
  font-size: 0.8rem;
}

.magnitude {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 92px;
  padding: 7px 10px;
  border-radius: 999px;
  font-weight: 700;
  font-size: 0.85rem;
}

.magnitude.safe {
  background: rgba(52, 211, 153, 0.12);
  color: #7ef0c2;
}

.magnitude.warning {
  background: rgba(251, 191, 36, 0.12);
  color: #fcd34d;
}

.magnitude.danger {
  background: rgba(248, 113, 113, 0.12);
  color: #fca5a5;
}

@media (max-width: 768px) {
  .topbar,
  .hero {
    flex-direction: column;
    align-items: flex-start;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }
}
